# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Azure App Registration (used for Microsoft Graph API) ─────────────────────
# Create an app registration in Azure AD and add these Application permissions:
#   Mail.Read, Mail.ReadWrite, Mail.Send
#   Files.ReadWrite.All, Sites.ReadWrite.All
# Then grant admin consent for the tenant.

AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Tesseract OCR path (Windows only – skip if tesseract.exe is on your PATH) ─
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
